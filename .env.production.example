# Non-secret production references only. This repository does not compose vendor
# adapters; the deployment must inject them into create_production_app(...).
ART_ENV=production
ART_AUTH_MODE=oidc
ART_OIDC_ISSUER=https://identity.example.invalid
ART_OIDC_AUDIENCE=art-sim
ART_OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
ART_OIDC_MFA_CLAIM=amr
ART_OIDC_MFA_VALUES=mfa
ART_CORS_ALLOWED_ORIGINS=https://command.example.invalid
ART_RATE_LIMIT_ENABLED=true
ART_MFA_REQUIRED_FOR_SENSITIVE_ACTIONS=true
ART_HSTS_ENABLED=true

ART_BROKER_PROVIDER=redis_streams
ART_BROKER_ENDPOINT=rediss://broker.example.invalid
ART_BROKER_QUEUE=art-sim
ART_BROKER_CREDENTIAL_SECRET_NAME=ART_BROKER_CREDENTIAL
ART_BROKER_TIMEOUT_SECONDS=5
ART_BROKER_VISIBILITY_SECONDS=300
ART_BROKER_MAX_IN_FLIGHT=64
ART_BROKER_MAX_DELIVERY_ATTEMPTS=5

ART_DATABASE_PROVIDER=postgresql
ART_DATABASE_DSN_SECRET_NAME=ART_DATABASE_DSN
ART_DATABASE_POOL_MIN=2
ART_DATABASE_POOL_MAX=20
ART_DATABASE_CONNECT_TIMEOUT_SECONDS=5
ART_DATABASE_STATEMENT_TIMEOUT_SECONDS=30

ART_SECRET_PROVIDER=hashicorp_vault
ART_APPROVAL_SECRET_NAME=ART_SIM_APPROVAL_SECRET
ART_OIDC_CLIENT_SECRET_NAME=ART_OIDC_CLIENT_SECRET
ART_AUDIT_PROVIDER=siem
ART_AUDIT_RETENTION_DAYS=365
ART_AUDIT_ARCHIVE_AFTER_DAYS=90
ART_TELEMETRY_PROVIDER=otlp
ART_RATE_LIMIT_PROVIDER=redis

ART_SIMULATION_RETENTION_DAYS=90
ART_RESULT_RETENTION_DAYS=90
ART_CHECKPOINT_RETENTION_DAYS=30
ART_DEAD_LETTER_RETENTION_DAYS=30
ART_TELEMETRY_RETENTION_DAYS=30
ART_TLS_TERMINATED_UPSTREAM=true
ART_TRUSTED_PROXY_HOPS=1
ART_REQUEST_TIMEOUT_SECONDS=30
ART_MAX_REQUEST_BYTES=65536
