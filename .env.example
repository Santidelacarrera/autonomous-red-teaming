# Development-only composition. Never copy real credentials into this file.
ART_ENV=development
ART_AUTH_MODE=development
ART_SIM_OPERATIONAL_DB=var/art-sim/operations.sqlite3
ART_RATE_LIMIT_ENABLED=true
ART_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
ART_MFA_REQUIRED_FOR_SENSITIVE_ACTIONS=false
ART_HSTS_ENABLED=false

# Optional local Neo4j Shadow Graph used only by seed_db.py/run_e2e.py.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-secret

# Frontend development values belong in frontend/.env.local.
VITE_BACKEND_URL=http://127.0.0.1:8080
VITE_API_BASE_URL=
VITE_AUTH_MODE=development
VITE_POLL_INTERVAL_MS=10000
